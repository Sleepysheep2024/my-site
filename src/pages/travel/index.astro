---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const cities = (await getCollection('travel', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

const fmt = (d: Date) => `${d.getFullYear()}.${String(d.getMonth() + 1).padStart(2, '0')}`;

const totalMoments = cities.reduce((sum, c) => sum + c.data.moments.length, 0);
---

<BaseLayout title="旅行 · 走过的城市" active="travel">
  <section class="shell page">
    <header class="head">
      <span class="eyebrow" data-reveal>Travel</span>
      <h1 class="display head__title" data-reveal>
        走过 <span class="brush">{cities.length}</span> 座城市
      </h1>
      <p class="head__sub" data-reveal>
        每一次出门都随手拍、随手写。照片旁边那些零碎的句子，才是真正留下来的东西。
      </p>
      <ul class="head__stats" data-reveal>
        <li><b>{cities.length}</b><span>座城市</span></li>
        <li><b>{totalMoments}</b><span>个瞬间</span></li>
        <li>
          <b>{[...new Set(cities.flatMap((c) => c.data.tags))].length}</b><span>个关键词</span>
        </li>
      </ul>
    </header>

    <div class="route" aria-hidden="true" data-reveal>
      <span class="route__line"></span>
      {
        cities.map((c) => (
          <span class="route__dot" title={c.data.city} />
        ))
      }
    </div>

    <div class="grid">
      {
        cities.map((city, i) => (
          <a
            class="city card"
            href={`/travel/${city.id}/`}
            data-reveal
            style={`transition-delay:${Math.min(i, 6) * 70}ms`}
          >
            <div class="city__photo">
              <img src={city.data.cover} alt={city.data.city} loading="lazy" />
              <span class="city__date">{fmt(city.data.date)}</span>
            </div>
            <div class="city__body">
              <div class="city__row">
                <h2 class="city__name">{city.data.city}</h2>
                {city.data.province && <span class="city__province">{city.data.province}</span>}
              </div>
              <p class="city__summary">{city.data.summary}</p>
              {
                city.data.tags.length > 0 && (
                  <ul class="city__tags">
                    {city.data.tags.slice(0, 3).map((tag) => (
                      <li class="tag tag--plain">{tag}</li>
                    ))}
                  </ul>
                )
              }
              <span class="city__go">
                {city.data.moments.length} 个瞬间 · 翻开 →
              </span>
            </div>
          </a>
        ))
      }
    </div>
  </section>
</BaseLayout>

<style>
  .head {
    padding: 68px 0 0;
    max-width: 720px;
  }

  .head__title {
    font-size: clamp(36px, 6vw, 62px);
    margin: 16px 0 0;
    letter-spacing: 0.03em;
  }

  .head__sub {
    font-size: 16.5px;
    line-height: 2;
    color: var(--ink-2);
    margin: 24px 0 0;
  }

  .head__stats {
    display: flex;
    flex-wrap: wrap;
    gap: 44px;
    list-style: none;
    padding: 30px 0 0;
    margin: 34px 0 0;
    border-top: 1px dashed var(--line);
  }

  .head__stats li {
    display: grid;
    gap: 2px;
  }

  .head__stats b {
    font-family: var(--font-display);
    font-size: 30px;
    font-weight: 400;
    color: var(--moss);
    line-height: 1.2;
  }

  .head__stats span {
    font-size: 12px;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }

  /* —— 路线装饰 —— */
  .route {
    position: relative;
    display: flex;
    align-items: center;
    gap: 0;
    margin: 64px 0 46px;
    height: 14px;
  }

  .route__line {
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    height: 1px;
    background-image: linear-gradient(to right, var(--line) 0 6px, transparent 6px 14px);
    background-size: 14px 1px;
    background-repeat: repeat-x;
  }

  .route__dot {
    position: relative;
    flex: 1 1 0;
    display: flex;
    justify-content: center;
  }

  .route__dot::before {
    content: "";
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--cream);
    border: 1.5px solid var(--mist);
  }

  .route__dot:first-child::before,
  .route__dot:last-child::before {
    background: var(--sprout);
    border-color: var(--moss);
  }

  /* —— 城市卡片墙 —— */
  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .city {
    display: flex;
    flex-direction: column;
  }

  .city__photo {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--cream-2);
  }

  .city__photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .city:hover .city__photo img {
    transform: scale(1.07);
  }

  .city__photo::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(to top, rgba(47, 79, 58, 0.3), transparent 55%);
    opacity: 0;
    transition: opacity 0.6s var(--ease);
  }

  .city:hover .city__photo::after {
    opacity: 1;
  }

  .city__date {
    position: absolute;
    left: 12px;
    top: 12px;
    z-index: 2;
    font-size: 10.5px;
    letter-spacing: 0.14em;
    color: var(--moss-deep);
    background: rgba(251, 249, 243, 0.88);
    backdrop-filter: blur(6px);
    border-radius: 999px;
    padding: 3px 10px;
  }

  .city__body {
    display: flex;
    flex-direction: column;
    flex: 1;
    padding: 17px 19px 19px;
  }

  .city__row {
    display: flex;
    align-items: baseline;
    gap: 8px;
    flex-wrap: wrap;
  }

  .city__name {
    font-family: var(--font-display);
    font-size: 19px;
    font-weight: 400;
    color: var(--moss-deep);
    margin: 0;
    letter-spacing: 0.05em;
  }

  .city__province {
    font-size: 11px;
    letter-spacing: 0.12em;
    color: var(--ink-3);
  }

  .city__summary {
    font-size: 13px;
    line-height: 1.8;
    color: var(--ink-2);
    margin: 9px 0 0;
  }

  .city__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    list-style: none;
    padding: 0;
    margin: 12px 0 0;
  }

  .city__tags .tag {
    font-size: 11px;
    padding: 3px 10px;
  }

  .city__go {
    margin-top: auto;
    padding-top: 15px;
    font-size: 11.5px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
    transition: color 0.4s var(--ease);
  }

  .city:hover .city__go {
    color: var(--moss);
  }

  /* —— 响应式 —— */
  @media (max-width: 1080px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 820px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 640px) {
    .grid {
      grid-template-columns: 1fr;
      gap: 24px;
    }

    .head {
      padding-top: 40px;
    }

    .head__stats {
      gap: 30px;
    }

    .route {
      margin: 44px 0 34px;
    }
  }
</style>
