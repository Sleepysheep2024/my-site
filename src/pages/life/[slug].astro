---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import LifeMap from '../../components/LifeMap.astro';

export async function getStaticPaths() {
  const outings = await getCollection('life', ({ data }) => !data.draft);
  const sorted = outings.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return sorted.map((outing, i) => ({
    params: { slug: outing.id },
    props: {
      outing,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { outing, prev, next } = Astro.props;
const { data } = outing;
const { Content } = await render(outing);

const hasPoint = data.lat !== undefined && data.lng !== undefined;

const fmt = (d: Date) =>
  `${d.getFullYear()} 年 ${d.getMonth() + 1} 月 ${d.getDate()} 日`;
---

<BaseLayout title={`${data.title} · 生活`} description={data.summary} active="life">
  <article class="shell page">
    <a class="back" href="/life/" data-reveal>← 回到生活</a>

    <!-- ============ 标题 ============ -->
    <header class="head" data-reveal>
      <span class="eyebrow">{fmt(data.date)}</span>
      <h1 class="display head__title">{data.title}</h1>
      <div class="head__meta">
        {data.place && <span class="head__place">📍 {data.place}</span>}
        {data.address && <span class="head__address">{data.address}</span>}
      </div>
      {data.summary && <p class="head__summary">{data.summary}</p>}
      {
        data.people.length > 0 && (
          <ul class="head__people">
            <li class="head__peopleLabel">同行的人</li>
            {data.people.map((person) => (
              <li class="tag">{person}</li>
            ))}
          </ul>
        )
      }
    </header>

    <figure class="cover" data-reveal>
      <span class="cover__wash" aria-hidden="true"></span>
      <img src={data.cover} alt={data.title} />
    </figure>

    <!-- ============ 地图 ============ -->
    {
      hasPoint && (
        <section class="mapbox" data-reveal>
          <div class="mapbox__head">
            <span class="eyebrow">Map</span>
            <h2 class="mapbox__title">那天在这个位置</h2>
          </div>
          <LifeMap
            points={[{ lat: data.lat as number, lng: data.lng as number, title: data.place || data.title }]}
            height="340px"
            zoom={12}
          />
        </section>
      )
    }

    <!-- ============ 那天的事 ============ -->
    {
      outing.body && outing.body.trim().length > 0 && (
        <section class="story" data-reveal>
          <span class="story__mark" aria-hidden="true">“</span>
          <div class="prose story__content">
            <Content />
          </div>
        </section>
      )
    }

    <!-- ============ 照片 ============ -->
    {
      data.photos.length > 0 && (
        <section class="photos">
          <div class="photos__head" data-reveal>
            <span class="eyebrow">Photos</span>
            <h2 class="photos__title">那天的照片</h2>
          </div>
          <div class="photos__grid">
            {data.photos.map((photo, i) => (
              <figure
                class:list={['photo', i === 0 && 'photo--wide']}
                data-reveal
                style={`transition-delay:${Math.min(i, 5) * 60}ms`}
              >
                <img src={photo.image} alt={photo.caption || data.title} loading="lazy" />
                {photo.caption && <figcaption class="photo__caption">{photo.caption}</figcaption>}
              </figure>
            ))}
          </div>
        </section>
      )
    }

    <!-- ============ 上下篇 ============ -->
    <nav class="pager" aria-label="出行导航">
      {
        prev ? (
          <a class="pager__item pager__item--prev" href={`/life/${prev.id}/`}>
            <span class="pager__label">更新的一条</span>
            <span class="pager__title">{prev.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager__item pager__item--next" href={`/life/${next.id}/`}>
            <span class="pager__label">更早的一条</span>
            <span class="pager__title">{next.data.title}</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-top: 44px;
    font-size: 13.5px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    transition: color 0.35s var(--ease);
  }

  .back:hover {
    color: var(--moss-deep);
  }

  /* ============ 标题 ============ */
  .head {
    padding: 44px 0 0;
    max-width: 760px;
  }

  .head__title {
    font-size: clamp(34px, 5.4vw, 58px);
    margin: 16px 0 0;
    letter-spacing: 0.03em;
    line-height: 1.4;
  }

  .head__meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 14px;
    margin: 20px 0 0;
  }

  .head__place {
    font-family: var(--font-display);
    font-size: 16px;
    color: var(--moss);
    letter-spacing: 0.05em;
  }

  .head__address {
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--ink-3);
  }

  .head__summary {
    font-family: var(--font-display);
    font-size: clamp(17px, 2.2vw, 20px);
    line-height: 1.95;
    color: var(--moss);
    margin: 22px 0 0;
  }

  .head__people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 9px;
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
  }

  .head__peopleLabel {
    font-size: 11.5px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-right: 4px;
  }

  /* ============ 封面 ============ */
  .cover {
    position: relative;
    margin: 52px 0 0;
    aspect-ratio: 16 / 9;
    isolation: isolate;
  }

  .cover__wash {
    position: absolute;
    inset: -14px -16px -12px -14px;
    z-index: -1;
    border-radius: 34px;
    background: linear-gradient(140deg, var(--sprout), var(--lake));
    opacity: 0.4;
    filter: blur(10px);
    transform: rotate(-0.8deg);
  }

  .cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 26px;
    box-shadow: var(--shadow-soft);
    background: var(--cream-2);
  }

  /* ============ 地图 ============ */
  .mapbox {
    margin: 76px 0 0;
  }

  .mapbox__head {
    margin-bottom: 20px;
  }

  .mapbox__title {
    font-family: var(--font-display);
    font-size: clamp(22px, 3.2vw, 30px);
    font-weight: 400;
    color: var(--moss-deep);
    margin: 10px 0 0;
    letter-spacing: 0.03em;
  }

  /* ============ 那天的事 ============ */
  .story {
    position: relative;
    margin: 76px 0 0;
    padding: 46px 52px 46px 74px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-soft);
  }

  .story__mark {
    position: absolute;
    left: 26px;
    top: 22px;
    font-family: var(--font-display);
    font-size: 62px;
    line-height: 1;
    color: var(--mist);
    opacity: 0.55;
  }

  /* ============ 照片 ============ */
  .photos {
    margin: 96px 0 0;
  }

  .photos__head {
    margin-bottom: 34px;
  }

  .photos__title {
    font-family: var(--font-display);
    font-size: clamp(24px, 3.4vw, 34px);
    font-weight: 400;
    color: var(--moss-deep);
    margin: 12px 0 0;
    letter-spacing: 0.03em;
  }

  .photos__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 22px;
  }

  .photo {
    position: relative;
    margin: 0;
    aspect-ratio: 4 / 3;
    border-radius: 20px;
    overflow: hidden;
    background: var(--cream-2);
    box-shadow: var(--shadow-soft);
  }

  .photo--wide {
    grid-column: 1 / -1;
    aspect-ratio: 16 / 9;
  }

  .photo img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.1s var(--ease);
  }

  .photo:hover img {
    transform: scale(1.04);
  }

  .photo__caption {
    position: absolute;
    left: 16px;
    bottom: 16px;
    font-size: 12px;
    letter-spacing: 0.1em;
    color: var(--moss-deep);
    background: rgba(251, 249, 243, 0.9);
    backdrop-filter: blur(6px);
    border-radius: 999px;
    padding: 5px 14px;
  }

  /* ============ 上下篇 ============ */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 110px;
    padding-top: 40px;
    border-top: 1px dashed var(--line);
  }

  .pager__item {
    display: grid;
    gap: 6px;
    padding: 24px 28px;
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
    background: rgba(255, 255, 255, 0.42);
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }

  .pager__item:hover {
    transform: translateY(-4px);
    border-color: var(--mist-2);
  }

  .pager__item--next {
    text-align: right;
  }

  .pager__label {
    font-size: 11.5px;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: 17px;
    line-height: 1.6;
    color: var(--moss-deep);
  }

  @media (max-width: 820px) {
    .cover {
      aspect-ratio: 4 / 3;
      margin-top: 36px;
    }

    .story {
      margin-top: 56px;
      padding: 34px 26px 34px 46px;
    }

    .photos__grid {
      grid-template-columns: 1fr;
      gap: 16px;
    }
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__item--next {
      text-align: left;
    }
  }
</style>
