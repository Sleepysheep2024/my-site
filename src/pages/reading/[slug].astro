---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export async function getStaticPaths() {
  const books = await getCollection('reading', ({ data }) => !data.draft);
  const sorted = books.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

  return sorted.map((book, i) => ({
    params: { slug: book.id },
    props: {
      book,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
    },
  }));
}

const { book, prev, next } = Astro.props;
const { data } = book;
const { Content } = await render(book);

const fmt = (d: Date) => `${d.getFullYear()} 年 ${d.getMonth() + 1} 月`;
---

<BaseLayout title={`《${data.title}》 · 阅读`} description={data.summary} active="reading">
  <article class="shell page">
    <a class="back" href="/reading/" data-reveal>← 回到书架</a>

    <!-- ============ 书籍信息 ============ -->
    <header class="head">
      <figure class="head__cover" data-reveal>
        <span class="head__wash" aria-hidden="true"></span>
        <img src={data.cover} alt={`《${data.title}》封面`} />
      </figure>

      <div class="head__text">
        <span class="eyebrow" data-reveal>{data.category} · {data.status} · {fmt(data.date)}</span>
        <h1 class="display head__title" data-reveal>《{data.title}》</h1>
        <p class="head__author" data-reveal>{data.author}</p>

        {
          data.rating > 0 && (
            <span class="head__stars" data-reveal aria-label={`评分 ${data.rating} 分`}>
              {Array.from({ length: 5 }).map((_, s) => (
                <i class:list={['head__star', s < data.rating && 'is-on']}>★</i>
              ))}
              <em>{data.rating}.0</em>
            </span>
          )
        }

        {data.summary && <p class="head__summary" data-reveal>{data.summary}</p>}

        {
          data.tags.length > 0 && (
            <ul class="head__tags" data-reveal>
              {data.tags.map((tag) => (
                <li class="tag">{tag}</li>
              ))}
            </ul>
          )
        }
      </div>
    </header>

    <!-- ============ 读后感 ============ -->
    {
      book.body && book.body.trim().length > 0 && (
        <section class="story" data-reveal>
          <span class="story__mark" aria-hidden="true">“</span>
          <div class="prose story__content">
            <Content />
          </div>
        </section>
      )
    }

    <!-- ============ 摘抄 + 批注 ============ -->
    {
      data.quotes.length > 0 && (
        <section class="quotes">
          <div class="quotes__head" data-reveal>
            <span class="eyebrow">Excerpts</span>
            <h2 class="quotes__title">抄下来的句子</h2>
            <p class="quotes__note">一共 {data.quotes.length} 条，每条后面都写了当时的想法。</p>
          </div>

          <ol class="quotes__list">
            {data.quotes.map((quote, i) => (
              <li class="quote" data-reveal>
                <span class="quote__index">{String(i + 1).padStart(2, '0')}</span>
                <blockquote class="quote__text">{quote.text}</blockquote>
                <div class="quote__foot">
                  {quote.page && <span class="quote__page">{quote.page}</span>}
                  {quote.note && (
                    <p class="quote__note">
                      <span class="quote__noteLabel">我的批注</span>
                      {quote.note}
                    </p>
                  )}
                </div>
              </li>
            ))}
          </ol>
        </section>
      )
    }

    <!-- ============ 上下本 ============ -->
    <nav class="pager" aria-label="书籍导航">
      {
        prev ? (
          <a class="pager__item pager__item--prev" href={`/reading/${prev.id}/`}>
            <span class="pager__label">更新的一本</span>
            <span class="pager__title">《{prev.data.title}》</span>
          </a>
        ) : (
          <span />
        )
      }
      {
        next ? (
          <a class="pager__item pager__item--next" href={`/reading/${next.id}/`}>
            <span class="pager__label">更早的一本</span>
            <span class="pager__title">《{next.data.title}》</span>
          </a>
        ) : (
          <span />
        )
      }
    </nav>
  </article>
</BaseLayout>

<style>
  .back {
    display: inline-block;
    margin-top: 44px;
    font-size: 13.5px;
    letter-spacing: 0.08em;
    color: var(--ink-3);
    transition: color 0.35s var(--ease);
  }

  .back:hover {
    color: var(--moss-deep);
  }

  /* ============ 书籍信息 ============ */
  .head {
    display: grid;
    grid-template-columns: 300px 1fr;
    gap: 64px;
    align-items: center;
    padding: 46px 0 0;
  }

  .head__cover {
    position: relative;
    margin: 0;
    aspect-ratio: 3 / 4;
    isolation: isolate;
  }

  .head__wash {
    position: absolute;
    inset: -18px -22px -14px -18px;
    z-index: -1;
    border-radius: 48% 52% 44% 56% / 54% 46% 54% 46%;
    background: linear-gradient(150deg, var(--sprout), var(--lake));
    opacity: 0.44;
    filter: blur(8px);
    transform: rotate(-3deg);
  }

  .head__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: 20px;
    box-shadow: var(--shadow-lift);
    background: var(--cream-2);
  }

  .head__title {
    font-size: clamp(32px, 5vw, 54px);
    margin: 14px 0 0;
    letter-spacing: 0.04em;
  }

  .head__author {
    font-family: var(--font-display);
    font-size: 17px;
    color: var(--moss);
    margin: 12px 0 0;
    letter-spacing: 0.06em;
  }

  .head__stars {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 16px;
    font-size: 15px;
    line-height: 1;
  }

  .head__star {
    font-style: normal;
    color: var(--line);
  }

  .head__star.is-on {
    color: var(--leaf-bright);
    text-shadow: 0 0 10px rgba(185, 228, 85, 0.65);
  }

  .head__stars em {
    font-style: normal;
    font-size: 12px;
    letter-spacing: 0.12em;
    color: var(--ink-3);
    margin-left: 8px;
  }

  .head__summary {
    font-family: var(--font-display);
    font-size: clamp(16px, 2vw, 19px);
    line-height: 1.95;
    color: var(--moss);
    margin: 20px 0 0;
    max-width: 34ch;
  }

  .head__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 9px;
    list-style: none;
    padding: 0;
    margin: 26px 0 0;
  }

  /* ============ 读后感 ============ */
  .story {
    position: relative;
    margin: 92px 0 0;
    padding: 46px 52px 46px 74px;
    background: rgba(255, 255, 255, 0.5);
    border-radius: var(--radius-lg);
    border: 1px solid var(--line-soft);
  }

  .story__mark {
    position: absolute;
    left: 26px;
    top: 22px;
    font-family: var(--font-display);
    font-size: 62px;
    line-height: 1;
    color: var(--mist);
    opacity: 0.55;
  }

  /* ============ 摘抄 ============ */
  .quotes {
    margin: 106px 0 0;
  }

  .quotes__head {
    margin-bottom: 44px;
  }

  .quotes__title {
    font-family: var(--font-display);
    font-size: clamp(26px, 4vw, 38px);
    font-weight: 400;
    color: var(--moss-deep);
    margin: 12px 0 0;
    letter-spacing: 0.03em;
  }

  .quotes__note {
    font-size: 14px;
    color: var(--ink-3);
    margin: 12px 0 0;
    letter-spacing: 0.04em;
  }

  .quotes__list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .quote {
    position: relative;
    padding: 40px 44px 36px;
    margin-bottom: 26px;
    border-radius: var(--radius-lg);
    background: linear-gradient(168deg, rgba(255, 255, 255, 0.8), rgba(255, 255, 255, 0.44));
    backdrop-filter: blur(10px);
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 18px 42px -34px rgba(34, 64, 42, 0.5);
  }

  .quote::before {
    content: "“";
    position: absolute;
    left: 20px;
    top: 6px;
    font-family: var(--font-display);
    font-size: 68px;
    line-height: 1;
    color: var(--sprout);
    opacity: 0.7;
  }

  .quote__index {
    position: absolute;
    right: 34px;
    top: 30px;
    font-family: var(--font-display);
    font-size: 13px;
    letter-spacing: 0.2em;
    color: var(--mist);
  }

  .quote__text {
    position: relative;
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(17px, 2.2vw, 21px);
    line-height: 2.05;
    color: var(--ink);
    letter-spacing: 0.02em;
    text-indent: 0;
  }

  .quote__foot {
    margin-top: 24px;
    padding-top: 20px;
    border-top: 1px dashed var(--line);
  }

  .quote__page {
    display: inline-block;
    font-size: 11.5px;
    letter-spacing: 0.14em;
    color: var(--moss);
    background: rgba(201, 228, 168, 0.42);
    border-radius: 999px;
    padding: 3px 12px;
    margin-bottom: 14px;
  }

  .quote__note {
    position: relative;
    margin: 0;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.95;
    color: var(--ink-2);
  }

  .quote__note::before {
    content: "";
    position: absolute;
    left: 0;
    top: 6px;
    bottom: 6px;
    width: 2px;
    border-radius: 2px;
    background: linear-gradient(to bottom, var(--lake), rgba(143, 199, 184, 0.25));
  }

  .quote__noteLabel {
    display: block;
    font-size: 11.5px;
    letter-spacing: 0.2em;
    color: var(--ink-3);
    margin-bottom: 8px;
  }

  /* ============ 上下本 ============ */
  .pager {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 24px;
    margin-top: 110px;
    padding-top: 40px;
    border-top: 1px dashed var(--line);
  }

  .pager__item {
    display: grid;
    gap: 6px;
    padding: 24px 28px;
    border-radius: var(--radius);
    border: 1px solid var(--line-soft);
    background: rgba(255, 255, 255, 0.42);
    transition:
      transform 0.5s var(--ease),
      border-color 0.5s var(--ease);
  }

  .pager__item:hover {
    transform: translateY(-4px);
    border-color: var(--mist-2);
  }

  .pager__item--next {
    text-align: right;
  }

  .pager__label {
    font-size: 11.5px;
    letter-spacing: 0.18em;
    color: var(--ink-3);
  }

  .pager__title {
    font-family: var(--font-display);
    font-size: 18px;
    color: var(--moss-deep);
  }

  @media (max-width: 820px) {
    .head {
      grid-template-columns: 1fr;
      gap: 34px;
    }

    .head__cover {
      max-width: 240px;
    }

    .story {
      margin-top: 64px;
      padding: 34px 26px 34px 46px;
    }

    .quote {
      padding: 34px 24px 30px 30px;
    }

    .quote::before {
      left: 10px;
      font-size: 52px;
    }

    .quote__index {
      right: 20px;
      top: 24px;
    }
  }

  @media (max-width: 640px) {
    .pager {
      grid-template-columns: 1fr;
    }

    .pager__item--next {
      text-align: left;
    }
  }
</style>
