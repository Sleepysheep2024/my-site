---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const books = (await getCollection('reading', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

/** 左侧分类顺序：先把常写的排前面，其余按出现顺序接上 */
const preferred = ['文学', '小说', '学习'];
const present = [...new Set(books.map((b) => b.data.category))];
const categories = [
  ...preferred.filter((c) => present.includes(c)),
  ...present.filter((c) => !preferred.includes(c)),
];

const groups = categories.map((category) => ({
  category,
  items: books.filter((b) => b.data.category === category),
}));

const totalQuotes = books.reduce((sum, b) => sum + b.data.quotes.length, 0);
---

<BaseLayout title="阅读 · 读过的书" active="reading">
  <section class="shell page">
    <header class="head">
      <span class="eyebrow" data-reveal>Reading</span>
      <h1 class="display head__title" data-reveal>
        读过 <span class="brush">{books.length}</span> 本书
      </h1>
      <p class="head__sub" data-reveal>
        看书很慢，忘得很快，所以只好把喜欢的句子抄下来。左边按分类挑，点封面能看到摘抄和当时的批注——一共 {totalQuotes} 条。
      </p>
    </header>

    <div class="shelf" data-shelf>
      <!-- ============ 左侧分类 ============ -->
      <aside class="side" data-reveal>
        <button class="side__item is-active" type="button" data-filter="all">
          <span class="side__name">全部</span>
          <span class="side__count">{books.length}</span>
        </button>
        {
          groups.map((group) => (
            <button class="side__item" type="button" data-filter={group.category}>
              <span class="side__name">{group.category}</span>
              <span class="side__count">{group.items.length}</span>
            </button>
          ))
        }
      </aside>

      <!-- ============ 书墙 ============ -->
      <div class="books">
        {
          groups.map((group) => (
            <section class="group" data-group={group.category} data-reveal>
              <h2 class="group__label">{group.category}</h2>
              <ul class="grid">
                {group.items.map((book) => (
                  <li>
                    <a class="book" href={`/reading/${book.id}/`}>
                      <span class="book__cover">
                        <img src={book.data.cover} alt={`《${book.data.title}》封面`} loading="lazy" />
                        <span
                          class:list={[
                            'book__status',
                            `book__status--${book.data.status === '读完' ? 'done' : book.data.status === '在读' ? 'reading' : 'want'}`,
                          ]}
                        >
                          {book.data.status}
                        </span>
                      </span>
                      <span class="book__title">{book.data.title}</span>
                      <span class="book__author">{book.data.author}</span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))
        }
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  document.querySelectorAll<HTMLElement>('[data-shelf]').forEach((shelf) => {
    const buttons = Array.from(shelf.querySelectorAll<HTMLButtonElement>('[data-filter]'));
    const groups = Array.from(shelf.querySelectorAll<HTMLElement>('[data-group]'));

    const apply = (value: string) => {
      buttons.forEach((btn) => btn.classList.toggle('is-active', btn.dataset.filter === value));
      groups.forEach((group) => {
        group.hidden = value !== 'all' && group.dataset.group !== value;
      });
    };

    buttons.forEach((btn) => {
      btn.addEventListener('click', () => apply(btn.dataset.filter ?? 'all'));
    });
  });
</script>

<style>
  .head {
    padding: 68px 0 0;
    max-width: 720px;
  }

  .head__title {
    font-size: clamp(36px, 6vw, 62px);
    margin: 16px 0 0;
    letter-spacing: 0.03em;
  }

  .head__sub {
    font-size: 16.5px;
    line-height: 2;
    color: var(--ink-2);
    margin: 24px 0 0;
  }

  /* ============ 整体：左栏 + 书墙 ============ */
  .shelf {
    display: grid;
    grid-template-columns: 168px 1fr;
    gap: 46px;
    align-items: start;
    margin-top: 58px;
  }

  /* ============ 左侧分类 ============ */
  .side {
    position: sticky;
    top: 96px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 14px 10px;
    border-radius: var(--radius-lg);
    background: rgba(255, 255, 255, 0.5);
    border: 1px solid var(--line-soft);
  }

  .side__item {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    width: 100%;
    padding: 11px 14px;
    border: none;
    border-radius: var(--radius);
    background: transparent;
    font-family: var(--font-display);
    font-size: 15px;
    letter-spacing: 0.14em;
    color: var(--ink-2);
    text-align: left;
    cursor: pointer;
    transition:
      background 0.4s var(--ease),
      color 0.4s var(--ease);
  }

  .side__item::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 3px;
    height: 0;
    border-radius: 3px;
    background: linear-gradient(to bottom, var(--sprout), var(--lake));
    transform: translateY(-50%);
    transition: height 0.4s var(--ease);
  }

  .side__item:hover {
    background: rgba(232, 246, 171, 0.34);
    color: var(--moss-deep);
  }

  .side__item.is-active {
    background: rgba(232, 246, 171, 0.5);
    color: var(--moss-deep);
  }

  .side__item.is-active::before {
    height: 22px;
  }

  .side__count {
    font-family: var(--font-body);
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-3);
  }

  .side__item.is-active .side__count {
    color: var(--moss);
  }

  /* ============ 书墙 ============ */
  .group {
    margin-bottom: 46px;
  }

  .group:last-child {
    margin-bottom: 0;
  }

  .group[hidden] {
    display: none;
  }

  .group__label {
    display: flex;
    align-items: center;
    gap: 14px;
    font-family: var(--font-display);
    font-size: 14px;
    font-weight: 400;
    letter-spacing: 0.22em;
    color: var(--moss);
    margin: 0 0 18px;
  }

  .group__label::after {
    content: "";
    flex: 1;
    height: 1px;
    background-image: linear-gradient(to right, var(--line) 0 6px, transparent 6px 14px);
    background-size: 14px 1px;
    background-repeat: repeat-x;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 16px 14px;
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .book {
    display: block;
  }

  .book__cover {
    position: relative;
    display: block;
    aspect-ratio: 3 / 4;
    border-radius: 12px;
    overflow: hidden;
    background: var(--cream-2);
    box-shadow: 0 12px 26px -20px rgba(34, 64, 42, 0.55);
    transition:
      transform 0.5s var(--ease),
      box-shadow 0.5s var(--ease);
  }

  .book:hover .book__cover {
    transform: translateY(-5px);
    box-shadow:
      0 20px 36px -22px rgba(34, 64, 42, 0.5),
      0 0 30px -14px rgba(203, 232, 127, 0.75);
  }

  .book__cover img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .book__status {
    position: absolute;
    left: 6px;
    top: 6px;
    font-size: 9.5px;
    letter-spacing: 0.08em;
    color: var(--moss-deep);
    background: rgba(251, 249, 243, 0.9);
    backdrop-filter: blur(6px);
    border-radius: 999px;
    padding: 2px 8px;
  }

  .book__status--reading {
    color: #4a6b2f;
    background: rgba(232, 246, 171, 0.94);
  }

  .book__status--want {
    color: var(--ink-2);
    background: rgba(255, 255, 255, 0.88);
  }

  .book__title {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    margin-top: 10px;
    font-size: 13px;
    line-height: 1.55;
    color: var(--moss-deep);
    letter-spacing: 0.02em;
    transition: color 0.35s var(--ease);
  }

  .book:hover .book__title {
    color: var(--moss);
  }

  .book__author {
    display: block;
    margin-top: 3px;
    font-size: 11px;
    color: var(--ink-3);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  /* ============ 响应式 ============ */
  @media (max-width: 1080px) {
    .shelf {
      grid-template-columns: 146px 1fr;
      gap: 32px;
    }

    .grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  @media (max-width: 820px) {
    .shelf {
      grid-template-columns: 1fr;
      gap: 28px;
    }

    .side {
      position: static;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 6px;
      padding: 10px;
    }

    .side__item {
      width: auto;
      padding: 8px 14px;
      font-size: 13.5px;
      gap: 7px;
    }

    .side__item::before {
      display: none;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 640px) {
    .head {
      padding-top: 40px;
    }

    .grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 14px 10px;
    }

    .book__title {
      font-size: 12px;
    }

    .book__author {
      display: none;
    }
  }
</style>
